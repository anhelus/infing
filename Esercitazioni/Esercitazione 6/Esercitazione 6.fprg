    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="N" type="Integer" array="False" size=""/>
            <assign variable="N" expression="10"/>
            <declare name="V" type="Real" array="True" size="N"/>
            <call expression="generaTempi(V, N)"/>
        </body>
    </function>
    <function name="generaTempi" type="None" variable="">
        <parameters>
            <parameter name="V" type="Real" array="True"/>
            <parameter name="N" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="N-1" direction="inc" step="1">
                <assign variable="V[i]" expression="random(100000)/1000"/>
            </for>
        </body>
    </function>
</flowgorithm>
